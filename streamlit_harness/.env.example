# Self-client OAuth credentials from api-console.zoho.com.
# Zoho API Console -> Self Client -> Generate Code -> paste this EXACT scope
# string (the "tables" group, not "datastore"/"baas" — those names don't
# exist and the console will reject them):
#   ZohoCatalyst.tables.READ,ZohoCatalyst.tables.rows.READ,ZohoCatalyst.tables.rows.CREATE,ZohoCatalyst.tables.rows.UPDATE,ZohoCatalyst.tables.rows.DELETE,ZohoCatalyst.tables.columns.READ,ZohoCatalyst.zcql.CREATE
# -> exchange the 10-min grant code for a refresh token (POST to
# https://accounts.zoho.in/oauth/v2/token, grant_type=authorization_code) —
# the refresh token itself doesn't expire, only the grant code does.
CATALYST_REFRESH_TOKEN=<SET_ME>
CATALYST_CLIENT_ID=<SET_ME>
CATALYST_CLIENT_SECRET=<SET_ME>

# From catalyst.json / .catalystrc in this repo
CATALYST_PROJECT_ID=53418000000019001
CATALYST_PROJECT_KEY=<SET_ME_ZAID>
CATALYST_ENVIRONMENT=Development

# Required — zcatalyst_sdk reads these at import time and silently defaults
# to unreachable *.localzoho.com placeholders without them (see
# catalyst_client.py comments for the full story on why).
CATALYST_ACCOUNTS_URL=https://accounts.zoho.in
X_ZOHO_CATALYST_ACCOUNTS_URL=https://accounts.zoho.in
X_ZOHO_CATALYST_CONSOLE_URL=https://console.catalyst.zoho.in
